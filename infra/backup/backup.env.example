# /etc/barberagency/backup.env
# Permissions: chmod 600 /etc/barberagency/backup.env
# Owner: root:root

# PostgreSQL Container & Database Settings
# PG_CONTAINER is optional. If unset or empty, auto-detected via ancestor=postgres:17
# PG_CONTAINER=""
PG_DATABASE="barberagency"
PG_USER="postgres"

# S3 Backup Bucket Settings
S3_BUCKET="barberagency-backups"
S3_ENDPOINT="" # Optional custom S3 endpoint URL (e.g. Cloudflare R2 or AWS S3 default)
AWS_ACCESS_KEY_ID="<REDACTED_ACCESS_KEY>"
AWS_SECRET_ACCESS_KEY="<REDACTED_SECRET_KEY>"
AWS_DEFAULT_REGION="us-east-1"

# Local Spool Directory
BACKUP_LOCAL_DIR="/var/backups/barberagency/postgres"
WP_BACKUP_LOCAL_DIR="/var/backups/barberagency/wordpress"

# WordPress Application & Database Settings
# WP_CONTAINER is optional. If unset or empty, auto-detected via ancestor=easypanel/barberagency/barberagency:latest
# WP_CONTAINER=""
# WP_DB_CONTAINER is optional. If unset or empty, auto-detected via ancestor=mariadb:11
# WP_DB_CONTAINER=""
WP_DB_NAME="wordpress"
WP_DB_USER="root"
WP_DB_PASS="<REDACTED_WP_DB_PASSWORD>"

# Protected n8n Secret Backup
N8N_ENCRYPTION_KEY="<REDACTED_PRODUCTION_N8N_ENCRYPTION_KEY>"
